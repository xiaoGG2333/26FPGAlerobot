+/* A fixed shared call budget bounds all initial-seed and fallback work. */
+typedef struct {ik_step_fn step;void *context;unsigned calls;int exhausted;} bounded_step_context;
+static int bounded_step(void *context,const float q[5],const float e[6],float lambda,float delta[5])
+{
