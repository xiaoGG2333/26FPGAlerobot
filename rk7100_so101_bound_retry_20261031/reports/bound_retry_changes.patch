+        seed[2]=fmaxf(so101_right_joints[2].q_min,fminf(so101_right_joints[2].q_max,seed[2]+bias));
+        seed[3]=fmaxf(so101_right_joints[3].q_min,fminf(so101_right_joints[3].q_max,seed[3]-bias));
+        if(fabsf(seed[2]-initial[2])+fabsf(seed[3]-initial[3])<1e-5f)continue;
+        ik_result trial;
+        rc=position_roll_attempt(xyz,roll,seed,max_steps<80?max_steps:80,tolerance,damping,bounded_step,&budget,&trial,1);
+        total+=trial.iterations;
+        if(budget.exhausted)break;
+        if(rc==2||rc==3||rc==4){*out=trial;out->iterations=total;return rc;}
+        if(!rc){double d=seed_distance(trial.q,initial);if(!have_best||d<score){best=trial;score=d;have_best=1;}}
+        else if(!have_best&&trial.energy<best.energy)best=trial;
+    }
+    *out=best;out->iterations=total;out->code=have_best?0:1;
+    return out->code;
+}
